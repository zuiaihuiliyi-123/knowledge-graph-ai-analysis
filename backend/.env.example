# 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# LLM API（DeepSeek 或 通义千问）
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding API（RAG 向量检索；DeepSeek 无 embedding 接口，用 SiliconFlow BAAI/bge-m3）
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# 关系型数据库（第一阶段 SQLite，第二阶段迁 MySQL）
SQLITE_DB_PATH=./data/app.db

# 文件上传
UPLOAD_DIR=./data/uploads

# 认证（JWT 签名密钥，生产环境务必改成随机值，至少 32 字节）
SECRET_KEY=please-set-a-random-secret-key-of-at-least-32-bytes
