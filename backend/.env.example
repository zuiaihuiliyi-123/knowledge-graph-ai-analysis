# 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# LLM API（DeepSeek 或 通义千问）
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 抽取时要求模型输出 JSON（response_format=json_object）；供应商不支持时自动回退，填 0 可关闭
LLM_JSON_MODE=1

# Embedding API（RAG 向量检索；DeepSeek 无 embedding 接口，用 SiliconFlow BAAI/bge-m3）
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# 关系型数据库（第一阶段 SQLite，第二阶段迁 MySQL）
# ⚠️ 强烈建议指向**仓库外**路径。历史提交曾跟踪 backend/data/app.db，
#    而 git switch / checkout 会静默覆盖被 .gitignore 忽略的同名文件
#    （2026-10-31 因此丢失过一次本地开发库）。下面的示例把库放在仓库同级目录。
#    默认值 ./data/app.db 仍可用，但请自行确认不会切到跟踪它的旧提交。
# SQLITE_DB_PATH=../../kg-data/app.db
SQLITE_DB_PATH=./data/app.db

# 启动前自动备份：每次启动在 init_tables()（幂等迁移，属写操作）之前留一份快照，
# 轮转只保留最近 AUTO_BACKUP_KEEP 份（写失败只告警，不阻塞启动）。
# 目录为 BACKUP_DIR/auto，默认 backend/backup/auto（该目录已在 .gitignore 中）。
# AUTO_BACKUP=1
# AUTO_BACKUP_KEEP=10
# BACKUP_DIR=./backup

# 文件上传
UPLOAD_DIR=./data/uploads

# JWT 签名密钥（务必改成随机长串；泄露等于任何人都能伪造登录态）
# 长度至少 32。未配置 / 过短 / 仍是历史默认值时，服务会改用本地随机密钥文件
# （backend/data/.secret_key，已在 .gitignore 中），并在启动日志里告警。
# 生产环境（APP_ENV=production）要求必须由本变量提供，否则启动直接失败。
# SECRET_KEY=change-me-to-a-long-random-string
# SECRET_KEY_FILE=./data/.secret_key    # 可选：改本地随机密钥文件位置

# 运行环境：dev（默认）| production。production 会强制校验 SECRET_KEY 来源。
# APP_ENV=dev

# 教师注册邀请码（阶段 1A 安全收口）
# 不配置 = 教师自助注册关闭（学生注册不受影响，教师账号由管理员创建/提升）。
# 配置后，注册 role=teacher 必须携带一致的 teacher_invite_code 字段。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(24))"
# TEACHER_INVITE_CODE=

# ---- 引导账号（首次启动自动创建；仅在账号尚不存在时生效，不会覆盖已改过的密码）----
# 代码里**没有**内置默认密码。不配置下面两项时，首次启动会随机生成密码并在启动
# 日志里打印一次，同时要求该账号首次登录后立即改密（must_change_password）。
# 正式部署请显式指定，别依赖日志传递凭据。
# DEFAULT_ADMIN_USERNAME=sysadmin
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_TEACHER_PASSWORD=




