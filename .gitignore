# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.env
*.egg

# 虚拟环境
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 上传文件（含 avatars/ 头像；上传目录里的 PDF/图片都是运行时产物，不随仓库流转）
# 注意：gitignore 里带「/」但不以「/」开头的模式是**锚定到本文件所在目录**的，
# 因此 `data/uploads/` 只能匹配根目录的 data/uploads，匹配不到 backend/data/uploads/——
# 这正是历史上那 30 个上传文件被提交进来的原因。两处都必须显式写。
data/uploads/
backend/data/uploads/

# SQLite 开发库：每台机器本地生成，含课程/文档记录与知识点向量索引，不随仓库流转。
# 历史上它被 git 跟踪，导致换机器后「文档记录说已抽取完成、Neo4j 里却没有节点」，
# RAG 检索恒为空、AI 只答「知识库中没有相关内容」且全程无报错。
# 重建图谱见 backend/scripts/rebuild_missing_graphs.py。
backend/data/app.db
backend/data/app.db-wal
backend/data/app.db-shm
backend/data/app.db-journal
# 库文件的快照/备份/空库占位（app.db.empty_*、app.db.pre_*、*.db 等）
backend/data/app.db.*
backend/data/*.db.bak
backend/backup/

# 日志与运行期产物
*.log
backend/logs/

# 编辑器 / 手工备份文件（历史上误提交过 GraphCanvas.vue.bak 等）
*.bak
*.bak.*
*.orig
*.rej

# 本地实验遗留的数据目录（曾把根目录的 data/ 整体搬进来，含 app.db，体积数 MB）
data.legacy-root-*/

# 根目录若被误跑 npm install，会生成这两个文件与 node_modules（前端依赖在 frontend-vue/ 下）
/node_modules/
/package.json
/package-lock.json

# Neo4j
neo4j/data/

# Streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db

# OpenStax 原始教材 PDF（体积大,仅保留本地,不提交）
backend/data/sample_docs/openstax_*/*.pdf
